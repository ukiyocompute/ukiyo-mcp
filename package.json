  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  }
}

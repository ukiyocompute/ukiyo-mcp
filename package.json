{
  "name": "@ukiyo/mcp",
  "version": "0.2.0",
  "description": "Ukiyo MCP server: let AI agents rent and use GPUs.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "ukiyo-mcp": "dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
